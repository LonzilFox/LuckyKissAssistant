<Window x:Class="LuckyKissAssistant.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Lucky Kiss Assistant" Width="1020" Height="760" MinWidth="780" MinHeight="600" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource AppBg}" Foreground="{StaticResource MainText}"
        FontFamily="Microsoft YaHei UI" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="16" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleDrag">
            <DockPanel Margin="22,0,14,0" LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Width="38" Height="32" Margin="0,0,4,0" Content="−" ToolTip="最小化" Click="MinimizeClick" Style="{StaticResource ChromeButton}"/>
                    <Button Width="38" Height="32" Margin="0,0,4,0" Content="□" ToolTip="最大化 / 还原" Click="MaximizeClick" Style="{StaticResource ChromeButton}"/>
                    <Button Width="38" Height="32" Content="×" ToolTip="关闭窗口" Click="CloseClick" Style="{StaticResource ChromeButton}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#40243C" CornerRadius="11" Width="34" Height="34" Margin="0,0,11,0">
                        <TextBlock Text="LK" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Primary}" FontWeight="Bold" FontSize="13"/>
                    </Border>
                    <TextBlock Text="Lucky Kiss" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text=" / ASSISTANT" Foreground="{StaticResource SubText}" FontSize="10" Margin="7,3,0,0" VerticalAlignment="Center"/>
                    <Border CornerRadius="7" Background="{StaticResource InputBg}" Padding="7,3" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="v0.0.4" FontSize="11" Foreground="{StaticResource SubText}"/></Border>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="22,13,22,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="NavDice" Content="骰子" Tag="dice" Style="{StaticResource NavSelectedButton}" Click="NavClick"/>
                <Button x:Name="NavGold" Content="金币" Tag="gold" Style="{StaticResource NavButton}" Click="NavClick"/>
                <Button x:Name="NavRelations" Content="好感度" Tag="relations" Style="{StaticResource NavButton}" Click="NavClick"/>
                <Button x:Name="NavStats" Content="角色属性" Tag="stats" Style="{StaticResource NavButton}" Click="NavClick"/>
                <Button x:Name="NavDiagnostic" Content="诊断" Tag="diag" Style="{StaticResource NavButton}" Click="NavClick"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Height="40" CornerRadius="12" Background="#31232F" Padding="14,0" Margin="0,0,10,0" VerticalAlignment="Center" MinWidth="112">
                    <TextBlock x:Name="ConnectionBadge" Text="未连接" Foreground="{StaticResource PrimaryLight}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="NoWrap"/>
                </Border>
                <Button x:Name="ConnectButton" Content="连接游戏" Height="40" MinWidth="105" Padding="15,0" VerticalAlignment="Center" Style="{StaticResource AccentButton}" Click="ConnectClick"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" Margin="22,0,22,0">
            <ScrollViewer x:Name="DicePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="VerticalOnly">
                <StackPanel Margin="0,0,12,18">
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="骰子控制" FontSize="23" FontWeight="SemiBold"/>
                            <TextBlock Text="保留 v0.0.3 已验证的五颗骰子结算修改方式；自动跟随游戏内选定数字。" Foreground="{StaticResource SubText}" Margin="0,8,0,18" FontSize="13"/>
                            <WrapPanel Margin="0,0,0,15">
                                <RadioButton x:Name="AutoMode" Content="跟随游戏选择" GroupName="DiceMode" IsChecked="True" Checked="ModeChanged"/>
                                <RadioButton x:Name="ManualMode" Content="手动指定点数" GroupName="DiceMode" Checked="ModeChanged"/>
                                <RadioButton x:Name="OffMode" Content="关闭" GroupName="DiceMode" Checked="ModeChanged"/>
                            </WrapPanel>
                            <UniformGrid x:Name="FaceGrid" Columns="6" Margin="0,0,0,16">
                                <Button Content="1" Tag="1" Click="FaceClick" Margin="0,0,8,0"/>
                                <Button Content="2" Tag="2" Click="FaceClick" Margin="0,0,8,0"/>
                                <Button Content="3" Tag="3" Click="FaceClick" Margin="0,0,8,0"/>
                                <Button Content="4" Tag="4" Click="FaceClick" Margin="0,0,8,0"/>
                                <Button Content="5" Tag="5" Click="FaceClick" Margin="0,0,8,0"/>
                                <Button Content="6" Tag="6" Click="FaceClick"/>
                            </UniformGrid>
                            <Border Background="{StaticResource InsetBg}" CornerRadius="12" Padding="15">
                                <StackPanel><TextBlock x:Name="DiceHook" Text="尚未连接游戏" Foreground="{StaticResource PrimaryLight}" Margin="0,0,0,7" FontSize="13"/>
                                    <TextBlock x:Name="DiceDetails" Text="暂无运行数据" Foreground="{StaticResource SubText}" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}"><StackPanel>
                        <TextBlock Text="安全退出" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="此操作不可在同一游戏进程中恢复！仅在准备真正退出游戏时使用；暂时停用骰子请选‘关闭’。点击后会再次确认。" Foreground="{StaticResource SubText}" FontSize="12" Margin="0,8,0,15"/>
                        <Button x:Name="SafeExitButtonDice" Content="停止修改 · 准备退出" HorizontalAlignment="Left" Click="SafeExitClick"/>
                    </StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="GoldPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,12,16"><Border Style="{StaticResource PanelCard}">
                    <StackPanel><TextBlock Text="金币修改" FontSize="23" FontWeight="SemiBold"/>
                        <TextBlock Text="保留已生效的金币运行时字段与 GameData 同步路径；重启后持久化仍取决于游戏自身保存。" Foreground="{StaticResource SubText}" Margin="0,9,0,18" FontSize="13"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="GoldInput" Text="99999999" Height="44" Grid.Column="0" Margin="0,0,10,0"/>
                            <Button x:Name="GoldSetButton" Grid.Column="1" Height="44" Content="设置金币" Style="{StaticResource AccentButton}" Click="GoldClick"/>
                        </Grid>
                        <TextBlock x:Name="GoldHook" Foreground="{StaticResource PrimaryLight}" Margin="0,18,0,6"/>
                        <TextBlock x:Name="GoldDetails" Foreground="{StaticResource SubText}" FontSize="12"/>
                    </StackPanel>
                </Border></StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="RelationsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,12,16">
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel><TextBlock Text="角色好感度" FontSize="23" FontWeight="SemiBold"/>
                            <TextBlock Text="对应 GameData._relationsLura / _relationsRiya。修改后会验证字段读回；剧情解锁及存档持久化需实机确认。" Foreground="{StaticResource SubText}" FontSize="13" Margin="0,9,0,15"/>
                            <Button Content="将读取值填入输入框" HorizontalAlignment="Left" Margin="0,0,0,14" Click="RestoreInputsClick" ToolTip="仅手动回填，不会提交修改；不会覆盖未点击本按钮时的正在编辑内容"/>
                            <StackPanel x:Name="RelationsList"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}"><StackPanel>
                        <TextBlock Text="关系读回状态" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="FeatureStatusText" Text="尚未发送修改请求。" Foreground="{StaticResource SubText}" FontSize="12" Margin="0,10,0,0"/>
                    </StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="StatsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,12,16">
                    <Border Style="{StaticResource PanelCard}"><StackPanel>
                        <DockPanel><TextBlock Text="角色属性编辑" FontSize="23" FontWeight="SemiBold"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="读取当前属性" Click="RefreshStatsClick" Margin="8,0,0,0"/>
                                <Button Content="回填输入框" Click="RestoreInputsClick" Margin="8,0,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="修改存档字段/升级点数。最终生命、速度、攻击等属性由游戏属性公式计算，无法把“升级点数”直接当作最终数值。" Foreground="{StaticResource SubText}" FontSize="12" Margin="0,9,0,16"/>
                        <TextBlock x:Name="StatsFeatureStatus" Text="等待读取属性。" FontSize="11" Foreground="{StaticResource PrimaryLight}" Margin="0,0,0,12"/>
                        <StackPanel x:Name="StatsList"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource PanelCard}"><StackPanel>
                        <TextBlock Text="游戏计算的最终属性 · 支持目标反推" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="填写最终目标数值会搜索相应升级点，只有游戏 Getter 读回匹配才保留；否则自动还原原有升级点。升级所需经验为只读。" Foreground="{StaticResource SubText}" Margin="0,7,0,12"/>
                        <StackPanel x:Name="CalculatedList"/>
                    </StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="DiagnosticPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,12,16">
                    <Border Style="{StaticResource PanelCard}"><StackPanel>
                        <DockPanel><TextBlock Text="运行诊断" FontSize="23" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="复制诊断" Click="CopyClick"/></DockPanel>
                        <TextBlock x:Name="ConnectionInfo" Text="等待连接游戏" Foreground="{StaticResource PrimaryLight}" FontSize="12" Margin="0,15,0,10"/>
                        <TextBlock x:Name="StatusText" Text="暂无" Foreground="{StaticResource MainText}" FontSize="12" Margin="0,0,0,10"/>
                        <TextBlock x:Name="ReportText" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource SubText}" TextWrapping="Wrap"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource PanelCard}"><StackPanel>
                        <TextBlock Text="退出和卡死排查" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="仅在真正退出游戏前使用‘停止修改’。此操作会结束原生线程，本游戏进程不能恢复写入，必须完全重启游戏。若退出仍卡死，请复制诊断并说明发生位置。" Foreground="{StaticResource SubText}" FontSize="12" Margin="0,7,0,14"/>
                        <Button x:Name="SafeExitButtonDiag" Content="停止修改 · 准备退出" HorizontalAlignment="Left" Click="SafeExitClick"/>
                    </StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0">
            <DockPanel Margin="22,0" VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Right" Text="LOCAL · WINDOWS x64 · ABI v5" Foreground="{StaticResource SubText}" FontSize="10"/>
                <TextBlock x:Name="FooterStatus" Text="等待连接游戏" Foreground="{StaticResource SubText}" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
